# MIRA configuration. Copy to .env, fill in what you have, and load it before starting the server:
#   set -a; source .env; set +a; uvicorn server.app:app --host 0.0.0.0 --port 8000
# Every setting is optional unless marked REQUIRED FOR PRODUCTION. Never commit .env (it is in .gitignore).
# Older RAQEEB_* names are still accepted. docs/API_GUIDE.md explains every external service below.

# ---------- core ----------
MIRA_ENV=development
# SQLite file (default data/raqeeb.db). MIRA_DATABASE_URL=sqlite:///path also works.
MIRA_DB=data/raqeeb.db
MIRA_DATABASE_URL=
# Not used yet: reserved for a shared rate limiter / queue when running several workers
MIRA_REDIS_URL=

# First-run super administrator (REQUIRED FOR PRODUCTION: set a strong password or let MIRA generate one)
MIRA_ADMIN_EMAIL=admin@mira.local
MIRA_ADMIN_PASSWORD=
# Fernet key that encrypts uploaded screenshots at rest; created in data/keys/ if empty
MIRA_EVIDENCE_KEY=
MIRA_BLOCK_EXPIRY_DAYS=30
MIRA_PORT=8000
MIRA_CORS_ORIGINS=
MIRA_RATE_LIMITS=
MIRA_POINTS=

# Hackathon demo mode: demo accounts, seeded scenario, demo sign-in prototype. NEVER enable in production.
MIRA_DEMO=

# ---------- detection engine ----------
MIRA_MODEL_PATH=
MIRA_RISK_LEVELS=25,50,75
MIRA_SANDBOX_ENABLED=true
# Navigation timeout in milliseconds (default 15000)
MIRA_SANDBOX_TIMEOUT=15000
# Chromium/Chrome binary if Playwright's own browser is not installed (e.g. /usr/bin/google-chrome)
MIRA_CHROMIUM=

# ---------- threat intelligence (optional; a missing key is reported as "not checked", never as clean) ----------
# Google Web Risk Lookup API (free up to 100,000 lookups/month, then paid)
MIRA_GOOGLE_THREAT_API_KEY=
# VirusTotal (free public API: 4 requests/minute, 500/day, non-commercial use only)
MIRA_VIRUSTOTAL_API_KEY=
# abuse.ch Auth-Key (free account at auth.abuse.ch; required for URLhaus since 30 June 2025)
MIRA_URLHAUS_AUTH_KEY=
# PhishTank application key (free developer registration)
MIRA_PHISHTANK_APP_KEY=

# ---------- Global Threat Discovery Engine ----------
MIRA_DISCOVERY_ENABLED=0
MIRA_DISCOVERY_INTERVAL_MIN=60

# ---------- citizen alert delivery (in-app always works; these channels need a provider and an adapter) ----------
MIRA_PUSH_PROVIDER_KEY=
MIRA_EMAIL_PROVIDER_KEY=
MIRA_SMS_PROVIDER_KEY=

# ---------- AI text (optional; any OpenAI-compatible endpoint, e.g. a local Ollama) ----------
MIRA_LLM_URL=
MIRA_LLM_MODEL=llama3.1
MIRA_LLM_KEY=

# ---------- UAE PASS (only after official onboarding; see docs/UAE_PASS_INTEGRATION.md) ----------
# Not used by the code yet: the shipped sign-in is a clearly labelled simulation.
MIRA_UAE_PASS_CLIENT_ID=
MIRA_UAE_PASS_CLIENT_SECRET=
MIRA_UAE_PASS_REDIRECT_URI=
