# RAQEEB configuration. Copy to .env and load it before starting the server:
#   set -a; source .env; set +a; uvicorn server.app:app --host 0.0.0.0 --port 8000
# Every setting is optional.

# Database file (default: data/raqeeb.db)
RAQEEB_DB=data/raqeeb.db

# First-run super administrator. If the password is empty, a random one is generated and written,
# together with the other official accounts, to data/first_run_credentials.txt.
RAQEEB_ADMIN_EMAIL=admin@raqeeb.local
RAQEEB_ADMIN_PASSWORD=

# Key that encrypts uploaded screenshots at rest (a Fernet key). If empty, one is created in data/keys/.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAQEEB_EVIDENCE_KEY=

# Default expiry for global blocks, in days
RAQEEB_BLOCK_EXPIRY_DAYS=30

# Port shown in the "Connect phones" QR code
RAQEEB_PORT=8000

# Allowed cross-origin callers, comma-separated (default: same origin only)
RAQEEB_CORS_ORIGINS=

# Override rate limits: {"name": [requests, seconds]}. Names: login, register, report, corroborate, check, upload
RAQEEB_RATE_LIMITS=

# Override Guardian points, e.g. {"new_website": 20, "verified_ad": 25}
RAQEEB_POINTS=

# Optional AI model for briefings: any OpenAI-compatible endpoint, such as a local Ollama (http://localhost:11434).
# If this is unset, RAQEEB writes briefings with its own rules. No paid API is required.
RAQEEB_LLM_URL=
RAQEEB_LLM_MODEL=llama3.1
RAQEEB_LLM_KEY=
